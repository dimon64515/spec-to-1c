// Разовая чистка «мин»: переименование характеристик с ВЕДУЩИМИ пробелами
// в чистое имя (СокрЛП). Ведущие пробелы — единственный класс имён, дающий
// крах «Оформить заказ» (генерат формы с пустым обозначением «  <материал>»
// не находится асимметричным поиском, БСП режет по СокрП), см.
// docs/АНАЛИЗ_БАГ_УНИКАЛЬНОСТЬ_ХАРАКТЕРИСТИК.md.
// Имена с хвостовыми пробелами НЕ трогаем: форма находит их через СокрЛП.
// Режим: «Проба» — только отчёт; «Запись» — переименование.
Режим = "Проба";
Результат = "";

Запрос = Новый Запрос;
Запрос.Текст = "ВЫБРАТЬ Х.Ссылка, Х.Владелец, Х.Наименование ИЗ Справочник.ХарактеристикиНоменклатуры КАК Х
|ГДЕ Х.Наименование ПОДОБНО &Шаблон
|УПОРЯДОЧИТЬ ПО Х.Владелец";
Запрос.УстановитьПараметр("Шаблон", " %");
Выборка = Запрос.Выполнить().Выбрать();

Переименовано = 0;
Конфликтов = 0;
Пустых = 0;
Пока Выборка.Следующий() Цикл
	Наим = Выборка.Наименование;
	Чистое = СокрЛП(Наим);
	Если Чистое = "" Тогда
		Пустых = Пустых + 1;
		Результат = Результат + "ПУСТОЕ-ИМЯ пропущено: " + Строка(Выборка.Ссылка) + Символы.ПС;
		Продолжить;
	КонецЕсли;

	// конфликт: у того же владельца уже есть элемент с таким СокрЛП-именем
	ЗапК = Новый Запрос;
	ЗапК.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Х.Ссылка ИЗ Справочник.ХарактеристикиНоменклатуры КАК Х
	|ГДЕ Х.Владелец = &Влад И Х.Ссылка <> &Ссылка И СокрЛП(Х.Наименование) = &Чистое";
	ЗапК.УстановитьПараметр("Влад", Выборка.Владелец);
	ЗапК.УстановитьПараметр("Ссылка", Выборка.Ссылка);
	ЗапК.УстановитьПараметр("Чистое", Чистое);
	Если НЕ ЗапК.Выполнить().Пустой() Тогда
		Конфликтов = Конфликтов + 1;
		Результат = Результат + "КОНФЛИКТ у [" + Строка(Выборка.Владелец) + "]: [" + Наим + "] — чистое имя занято, нужен ручной мердж" + Символы.ПС;
		Продолжить;
	КонецЕсли;

	Если Режим = "Запись" Тогда
		ОбъектХ = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектХ.Наименование = Чистое;
		Попытка
			ОбъектХ.Записать();
			Переименовано = Переименовано + 1;
			Результат = Результат + "OK [" + Наим + "] -> [" + Чистое + "] у [" + Строка(Выборка.Владелец) + "]" + Символы.ПС;
		Исключение
			Результат = Результат + "ОШИБКА записи [" + Наим + "]: " + ОписаниеОшибки() + Символы.ПС;
		КонецПопытки;
	Иначе
		Переименовано = Переименовано + 1;
		Результат = Результат + "БУДЕТ [" + Наим + "] -> [" + Чистое + "] у [" + Строка(Выборка.Владелец) + "]" + Символы.ПС;
	КонецЕсли;
КонецЦикла;

Результат = Результат + "ИТОГ: к переименованию=" + Переименовано + " конфликтов=" + Конфликтов + " пустых=" + Пустых + " режим=" + Режим + Символы.ПС;
