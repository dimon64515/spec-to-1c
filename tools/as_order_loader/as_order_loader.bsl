// ┌────────────────────────────────────────────────────────────────────────────┐
// │ Обработка: асЗагрузкаЗаказаИзJSON                                          │
// │ Назначение: создание документа асСпецификацияЗаказа из JSON-спецификации   │
// │             без XML-импорта и без ручного ввода.                            │
// │                                                                             │
// │ Транспорт-независимость: единая точка входа ЗагрузитьЗаказ(СтрокаJSON).    │
// │ Сегодня вызывается через MCP (execute_code / расширение MCP Toolkit),       │
// │ далее — из HTTP-сервиса 1С для бота/Битрикса. Контракт JSON не меняется.    │
// │                                                                             │
// │ Формат входного JSON (массив позиций):                                      │
// │ [                                                                           │
// │   {                                                                         │
// │     "article":   "1-2-1",          // артикул из справочника асПродукция    │
// │     "qty":       6,                // количество                            │
// │     "thickness": 0.8,              // толщина металла                       │
// │     "material":  "Рулон оц.(08ПС)0.80",  // имя в асМатериалы (точное)      │
// │     "shina":     "65",             // 65/95/105 — шина на соединение; ""    │
// │     "conn0":     "6",              // код соединения c0: 6=Шина/уголок,     │
// │                                     // 2=Без соединения; "" — не задавать   │
// │     "conn1":     "6",              // то же для c1                          │
// │     "params":    {"A0":400,"B0":200,"L0":1250},  // размеры строки ТЧ       │
// │     "comment":   "..."             // КомментарийКПродукцииИзOnLine         │
// │   }                                                                         │
// │ ]                                                                           │
// │                                                                             │
// │ Результат — структура:                                                      │
// │   Успех          Булево                                                      │
// │   НомерЗаказа    Строка (например "000000852")                               │
// │   КоличествоСтрок Число                                                      │
// │   Ошибки         Массив строк ("строка N: ...")                              │
// │   Предупреждения Массив строк (например, нулевая цена по прайсу)             │
// │                                                                             │
// │ Площади/массы/цены считаются автоматически штатной обработкой                │
// │ асВводНовогоЗаказа (точный паритет с кнопкой «Расчёт», проверено на 851).    │
// └────────────────────────────────────────────────────────────────────────────┘

// Точка входа. Принимает JSON-строку спецификации, создаёт и записывает заказ.
//
Функция ЗагрузитьЗаказ(СтрокаJSON) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("НомерЗаказа", "");
	Результат.Вставить("КоличествоСтрок", 0);
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("Предупреждения", Новый Массив);

	Позиции = ПрочитатьПозиции(СтрокаJSON, Результат.Ошибки);
	Если Позиции = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ДокОбъект = Документы.асСпецификацияЗаказа.СоздатьДокумент();
		ДокОбъект.Дата = ТекущаяДатаСеанса();
		ДокОбъект.Комментарий = "Загрузка из JSON (асЗагрузкаЗаказаИзJSON)";

		НомерСтроки = 0;
		Для Каждого П Из Позиции Цикл
			НомерСтроки = НомерСтроки + 1;
			ЗаполнитьСтроку(ДокОбъект, П, НомерСтроки, Результат);
		КонецЦикла;

		// Площади, массы и цены — одним проходом штатной обработки (паритет с кнопкой «Расчёт»).
		РассчитатьВсеСтроки(ДокОбъект, Результат);

		ДокОбъект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибки.Добавить("Запись документа: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = (Результат.Ошибки.Количество() = 0);
	Результат.НомерЗаказа = ДокОбъект.Номер;
	Результат.КоличествоСтрок = ДокОбъект.Товары.Количество();
	Возврат Результат;

КонецФункции

// Возвращает результат ЗагрузитьЗаказ в виде JSON-строки — удобно для HTTP.
//
Функция ЗагрузитьЗаказВернутьJSON(СтрокаJSON) Экспорт

	Результат = ЗагрузитьЗаказ(СтрокаJSON);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Результат);
	Возврат Запись.Закрыть();

КонецФункции

#Область Служебные

Функция ПрочитатьПозиции(СтрокаJSON, Ошибки)

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(СтрокаJSON);
		Данные = ПрочитатьJSON(Чтение, Истина); // соответствиями
	Исключение
		Ошибки.Добавить("Разбор JSON: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Ошибки.Добавить("JSON должен быть массивом позиций");
		Возврат Неопределено;
	КонецЕсли;

	Позиции = Новый Массив;
	Для Каждого Элемент Из Данные Цикл
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
			Ошибки.Добавить("Элемент спецификации не является объектом");
			Продолжить;
		КонецЕсли;
		Позиции.Добавить(Элемент);
	КонецЦикла;

	Возврат Позиции;

КонецФункции

Процедура ЗаполнитьСтроку(ДокОбъект, П, НомерСтроки, Результат)

	Ошибки = Результат.Ошибки;
	Стр = ДокОбъект.Товары.Добавить();

	// Продукт — ссылка на Справочник.асПродукция (обязательно! не Номенклатура).
	Артикул = Свойство(П, "article");
	Продукт = Справочники.асПродукция.НайтиПоРеквизиту("Артикул", Артикул);
	Если Не ЗначениеЗаполнено(Продукт) Тогда
		Ошибки.Добавить("Строка " + НомерСтроки + ": не найден продукт с артикулом """ + Артикул + """");
	Иначе
		Стр.Продукт = Продукт;
		Стр.Номенклатура = Продукт.Продукт;
		Стр.АртикулПродукции = Артикул;
		ПозДефиса = СтрНайти(Артикул, "-");
		Стр.АртикулГруппы = ?(ПозДефиса > 0, Лев(Артикул, ПозДефиса - 1), Артикул);
		Стр.ГруппаПродукцииСтр = Продукт.ГруппаПродукции;
		Стр.СечениеСтр = Продукт.ВидСечения;
	КонецЕсли;

	Количество = ЧислоСвойства(П, "qty", 1);
	Стр.n = Количество;
	Стр.np = Количество;

	Толщина = ЧислоСвойства(П, "thickness", 0);
	Стр.t = Толщина;
	Стр.t2 = Толщина;

	// Материал — точное наименование из справочника асМатериалы (два знака толщины!).
	ИмяМатериала = Свойство(П, "material");
	Стр.Материал = Справочники.асМатериалы.НайтиПоНаименованию(ИмяМатериала, Истина);
	Стр.Материал2 = Стр.Материал;
	Если Не ЗначениеЗаполнено(Стр.Материал) Тогда
		Ошибки.Добавить("Строка " + НомерСтроки + ": не найден материал """ + ИмяМатериала + """");
	КонецЕсли;

	Стр.КомментарийКПродукцииИзOnLine = Свойство(П, "comment");

	// Шина на соединение: 65/95/105 по правилам техотдела (≤350 / 400–950 / ≥1000).
	// Для нержавеющих изделий с шиной 65 — нерж-вариант составного соединения.
	Шина = Свойство(П, "shina");
	Если ЗначениеЗаполнено(Шина) Тогда
		Нерж = СтрНайти(ИмяМатериала, "нерж") > 0;
		Если Нерж И Шина = "65" Тогда
			ИмяШины = "Шина 20(нерж.430) / УГФ 65(нерж.430)";
		Иначе
			ИмяШины = ?(Шина = "105", "Шина 30 / УГФ 105", "Шина 20 / УГФ " + Шина);
		КонецЕсли;
		ШинаСсылка = Справочники.асПродукция.НайтиПоНаименованию(ИмяШины, Истина);
		Стр.МатериалНаСоединение0 = ШинаСсылка;
		Стр.МатериалНаСоединение1 = ШинаСсылка;
		Если Не ЗначениеЗаполнено(ШинаСсылка) Тогда
			Ошибки.Добавить("Строка " + НомерСтроки + ": не найдена шина """ + ИмяШины + """");
		КонецЕсли;
	КонецЕсли;

	// Соединения: 6 = "Шина / уголок", 2 = "Без соединения".
	УстановитьСоединение(Стр, Свойство(П, "conn0"), "c0", НомерСтроки, Ошибки);
	УстановитьСоединение(Стр, Свойство(П, "conn1"), "c1", НомерСтроки, Ошибки);

	// Размеры и прочие параметры строки.
	Параметры = П.Получить("params");
	Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
		Для Каждого КЗ Из Параметры Цикл
			Попытка
				Стр[КЗ.Ключ] = КЗ.Значение;
			Исключение
				Результат.Предупреждения.Добавить("Строка " + НомерСтроки + ": параметр """ + КЗ.Ключ + """ не применён");
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	// Производные размеры (a1, b1, d1, p, ...) из регистра настроек продукции.
	// Без этого шага у фасонки (шумоглушители и др.) расчёт площади уходит в минус.
	ПрименитьНастройкиПродукции(Стр, Продукт, НомерСтроки, Результат);

	// Расчёт S/M/цены не делаем здесь: всеми строками разом занимается РассчитатьВсеСтроки.

КонецПроцедуры

Процедура УстановитьСоединение(Стр, КодСоединения, Суффикс, НомерСтроки, Ошибки)

	Если Не ЗначениеЗаполнено(КодСоединения) Тогда
		Возврат;
	КонецЕсли;

	Если КодСоединения = "6" Тогда
		ИмяСоединения = "Шина / уголок";
	ИначеЕсли КодСоединения = "2" Тогда
		ИмяСоединения = "Без соединения";
	Иначе
		Ошибки.Добавить("Строка " + НомерСтроки + ": неизвестный код соединения """ + КодСоединения + """");
		Возврат;
	КонецЕсли;

	Соединение = Справочники.асСоединениеВоздуховодов.НайтиПоНаименованию(ИмяСоединения, Истина);
	Если Не ЗначениеЗаполнено(Соединение) Тогда
		Ошибки.Добавить("Строка " + НомерСтроки + ": не найдено соединение """ + ИмяСоединения + """");
		Возврат;
	КонецЕсли;

	Стр["СоединениеВоздуховода_" + Суффикс] = Соединение;

КонецПроцедуры

Процедура ПрименитьНастройкиПродукции(Стр, Продукт, НомерСтроки, Результат)

	Если Не ЗначениеЗаполнено(Продукт) Тогда
		Возврат;
	КонецЕсли;

	ЗапросН = Новый Запрос(
	"ВЫБРАТЬ
	|	Н.ПараметрПродукции КАК ПараметрПродукции,
	|	Н.Вариант КАК Вариант,
	|	Н.КонстантаЗначения КАК КонстантаЗначения,
	|	Н.ЗависимыйПараметр КАК ЗависимыйПараметр,
	|	Н.Оператор КАК Оператор,
	|	Н.ЧислоX КАК ЧислоX
	|ИЗ
	|	РегистрСведений.асНастройкиПродукции КАК Н
	|ГДЕ
	|	Н.Продукт = &Продукт");
	ЗапросН.УстановитьПараметр("Продукт", Продукт);
	ВыборкаН = ЗапросН.Выполнить().Выбрать();

	Пока ВыборкаН.Следующий() Цикл
		ИмяП = Строка(ВыборкаН.ПараметрПродукции);
		Попытка
			Текущее = Стр[ИмяП];
		Исключение
			Продолжить; // такого реквизита в ТЧ нет — пропускаем
		КонецПопытки;
		Если Текущее <> 0 Тогда
			Продолжить; // значение задано спецификацией — не перезаписываем
		КонецЕсли;

		Если ВыборкаН.Вариант = "Вариант1" Тогда
			Попытка
				Стр[ИмяП] = ВыборкаН.КонстантаЗначения;
			Исключение
			КонецПопытки;
		ИначеЕсли ВыборкаН.Вариант = "Вариант2" Тогда
			Попытка
				База = Стр[Строка(ВыборкаН.ЗависимыйПараметр)];
				Если ВыборкаН.Оператор = Справочники.асАрифметическиеОператоры.Сложение Тогда
					Стр[ИмяП] = База + ВыборкаН.ЧислоX;
				ИначеЕсли ВыборкаН.Оператор = Справочники.асАрифметическиеОператоры.Вычитание Тогда
					Стр[ИмяП] = База - ВыборкаН.ЧислоX;
				ИначеЕсли ВыборкаН.Оператор = Справочники.асАрифметическиеОператоры.Умножение Тогда
					Стр[ИмяП] = База * ВыборкаН.ЧислоX;
				ИначеЕсли ВыборкаН.Оператор = Справочники.асАрифметическиеОператоры.Деление Тогда
					Стр[ИмяП] = ?(ВыборкаН.ЧислоX = 0, 0, База / ВыборкаН.ЧислоX);
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Единый расчёт всех строк документа — ровно то, что делает кнопка «Расчёт»
// в обработке асВводНовогоЗаказа: Расчеты_D → РасчетФормул → УстановкаПрайсаНаСервере
// → РасчетЦен → РасчетЦеныЗаЕдиницу. Проверено на заказе 851: S, типы цен и цены
// совпали с интерактивным пересчётом по всем 20 строкам.
//
// Два реквизита обработки, которые интерактивная форма заполняет при открытии,
// выставляем явно (иначе площадь без замков и пустой ТекущаяПрограмма1С):
//   - ТекущаяПрограмма1С = "КА" — конфигурация базы (Комплексная автоматизация);
//   - УчитыватьЗамкиВРасчетеПлощадиДляСчета = Истина — S = Sclean + Slock.
//
Процедура РассчитатьВсеСтроки(ДокОбъект, Результат)

	Если ДокОбъект.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		О = Обработки.асВводНовогоЗаказа.Создать();
	Исключение
		Результат.Предупреждения.Добавить("Расчёт невозможен: обработка асВводНовогоЗаказа недоступна — " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	О.ДатаУстановкиЦен = ТекущаяДатаСеанса();
	Попытка О.ТекущаяПрограмма1С = "КА"; Исключение КонецПопытки;
	Попытка О.УчитыватьЗамкиВРасчетеПлощадиДляСчета = Истина; Исключение КонецПопытки;

	// Переносим строки документа в ТЧ Заказы обработки (только общие колонки).
	КолонкиЗаказы = О.Заказы.Выгрузить().Колонки;
	Для Каждого Стр Из ДокОбъект.Товары Цикл
		З = О.Заказы.Добавить();
		Для Каждого к Из КолонкиЗаказы Цикл
			Попытка З[к.Имя] = Стр[к.Имя]; Исключение КонецПопытки;
		КонецЦикла;
		З.ТребуетсяПересчет = Истина;
	КонецЦикла;

	Попытка
		О.РедактироватьВсеНаКлиенте_ДляИзмененныхВМодуле();
	Исключение
		Результат.Предупреждения.Добавить("Расчёт не выполнен: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// Забираем результаты обратно в строки документа.
	Инд = 0;
	Для Каждого Стр Из ДокОбъект.Товары Цикл
		Инд = Инд + 1;
		З = О.Заказы[Инд - 1];
		Для Каждого к Из КолонкиЗаказы Цикл
			Попытка Стр[к.Имя] = З[к.Имя]; Исключение КонецПопытки;
		КонецЦикла;
		Если Стр.ЦенаЕд = 0 Тогда
			Результат.Предупреждения.Добавить("Строка " + Инд + " (" + Стр.АртикулПродукции + "): цена 0 — проверьте прайс (тип цены """ + Стр.ТипЦеныПоПрайсу + """)");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция Свойство(Объект, Имя)

	Значение = Объект.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Значение);

КонецФункции

Функция ЧислоСвойства(Объект, Имя, ЗначениеПоУмолчанию)

	Значение = Объект.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;

КонецФункции

#КонецОбласти
