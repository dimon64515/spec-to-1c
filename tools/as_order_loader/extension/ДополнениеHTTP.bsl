// ┌────────────────────────────────────────────────────────────────────────────┐
// │ Дополнение к общему модулю ВОКЗагрузкаЗаказаHTTP (расширение конфигурации) │
// │                                                                            │
// │ Вставляется в модуль ПОСЛЕ полного кода обработки асЗагрузкаЗаказаИзJSON   │
// │ (файл ../../as_order_loader.bsl — все функции: ЗагрузитьЗаказ,             │
// │  ЗаполнитьСтроку, РассчитатьВсеСтроки и т.д.).                             │
// │                                                                            │
// │ Новая точка входа для HTTP-сервиса:                                        │
// │   ЗагрузитьЗаказHTTP(СтрокаJSONПозиций, Комментарий, RequestId)            │
// │                                                                            │
// │ Отличия от ЗагрузитьЗаказ:                                                 │
// │   1. Комментарий документа — из запроса (order_comment бота).              │
// │   2. Идемпотентность: если передан RequestId и заказ с таким ключом уже    │
// │      создан — повторный вызов вернёт номер СУЩЕСТВУЮЩЕГО заказа,           │
// │      дубликат не создаётся. Ключ пишется в конец комментария:              │
// │      "<Комментарий> [req:<RequestId>]".                                    │
// └────────────────────────────────────────────────────────────────────────────┘

// Точка входа HTTP-сервиса. СтрокаJSONПозиций — массив позиций по контракту
// as_order_loader (article/qty/thickness/material/shina/conn0/conn1/params/comment).
// Возвращает структуру: Успех, НомерЗаказа, КоличествоСтрок, Ошибки,
// Предупреждения (тот же набор, что ЗагрузитьЗаказ).
//
Функция ЗагрузитьЗаказHTTP(СтрокаJSONПозиций, Комментарий, RequestId) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("НомерЗаказа", "");
	Результат.Вставить("КоличествоСтрок", 0);
	Результат.Вставить("Ошибки", Новый Массив);
	Результат.Вставить("Предупреждения", Новый Массив);

	ИтоговыйКомментарий = СокрЛП(Комментарий);
	Если ЗначениеЗаполнено(RequestId) Тогда
		ИтоговыйКомментарий = ИтоговыйКомментарий + " [req:" + СокрЛП(RequestId) + "]";
		// Идемпотентность: заказ с таким ключом уже создавали — возвращаем его.
		Существующий = НайтиЗаказПоКлючу(ИтоговыйКомментарий);
		Если Существующий <> Неопределено Тогда
			Результат.Успех = Истина;
			Результат.НомерЗаказа = Существующий.Номер;
			Результат.КоличествоСтрок = Существующий.Товары.Количество();
			Результат.Предупреждения.Добавить("Заказ уже существует (идемпотентный повтор)");
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИтоговыйКомментарий) Тогда
		ИтоговыйКомментарий = "Загрузка из JSON (HTTP-сервис)";
	КонецЕсли;

	Позиции = ПрочитатьПозиции(СтрокаJSONПозиций, Результат.Ошибки);
	Если Позиции = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ДокОбъект = Документы.асСпецификацияЗаказа.СоздатьДокумент();
		ДокОбъект.Дата = ТекущаяДатаСеанса();
		ДокОбъект.Комментарий = ИтоговыйКомментарий;

		НомерСтроки = 0;
		Для Каждого П Из Позиции Цикл
			НомерСтроки = НомерСтроки + 1;
			ЗаполнитьСтроку(ДокОбъект, П, НомерСтроки, Результат);
		КонецЦикла;

		РассчитатьВсеСтроки(ДокОбъект, Результат);

		ДокОбъект.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат.Ошибки.Добавить("Запись документа: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Результат.Успех = (Результат.Ошибки.Количество() = 0);
	Результат.НомерЗаказа = ДокОбъект.Номер;
	Результат.КоличествоСтрок = ДокОбъект.Товары.Количество();
	Возврат Результат;

КонецФункции

// Поиск ранее созданного заказа по полному комментарию с ключом [req:...].
//
Функция НайтиЗаказПоКлючу(ИтоговыйКомментарий)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	З.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.асСпецификацияЗаказа КАК З
	|ГДЕ
	|	З.Комментарий = &Комментарий
	|
	|УПОРЯДОЧИТЬ ПО
	|	З.Дата УБЫВ");
	Запрос.УстановитьПараметр("Комментарий", ИтоговыйКомментарий);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Возврат Неопределено;

КонецФункции
