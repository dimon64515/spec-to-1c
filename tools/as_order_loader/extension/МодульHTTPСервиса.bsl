// ┌────────────────────────────────────────────────────────────────────────────┐
// │ Модуль HTTP-сервиса «ВОКЗагрузкаЗаказа» (расширение конфигурации)          │
// │                                                                            │
// │ Метаданные (создаются в конфигураторе, см. README.md рядом с этим файлом): │
// │   HTTP-сервис: ВОКЗагрузкаЗаказа, корневой URL шаблона — /vok              │
// │   Шаблон URL: order  (/vok/order)                                          │
// │   Метод: POST → обработчик ЗаказОбработатьPOST (этот модуль)               │
// │                                                                            │
// │ Контракт запроса/ответа — docs/ТЗ_HTTP_СЕРВИС_ЗАГРУЗКА_ЗАКАЗА_1С.md.       │
// └────────────────────────────────────────────────────────────────────────────┘

// POST /vok/order
// Тело: {"order_comment": "...", "request_id": "...", "positions": [ ... ]}
// Ответ 200: {"Успех": true,  "НомерЗаказа": "000000860", "Ошибки": [], "Предупреждения": []}
// Ответ 500: {"Успех": false, "НомерЗаказа": null,       "Ошибки": ["..."], "Предупреждения": []}
//
Функция ЗаказОбработатьPOST(Запрос)

	Попытка
		Тело = Запрос.ПолучитьТелоКакСтроку();

		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(Чтение, Истина); // соответствиями
		Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
			ВызватьИсключение "тело запроса должно быть JSON-объектом";
		КонецЕсли;

		Комментарий = СтрокаСвойства(Данные, "order_comment");
		RequestId   = СтрокаСвойства(Данные, "request_id");
		Позиции     = Данные.Получить("positions");
		Если ТипЗнч(Позиции) <> Тип("Массив") Тогда
			ВызватьИсключение "поле ""positions"" должно быть массивом";
		КонецЕсли;

		// Загрузчик принимает JSON-строку массива позиций — сериализуем обратно.
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, Позиции);
		СтрокаПозиций = Запись.Закрыть();

		Результат = ВОКЗагрузкаЗаказаHTTP.ЗагрузитьЗаказHTTP(СтрокаПозиций, Комментарий, RequestId);
		КодСостояния = 200;
	Исключение
		Результат = Новый Структура;
		Результат.Вставить("Успех", Ложь);
		Результат.Вставить("НомерЗаказа", Неопределено);
		Результат.Вставить("КоличествоСтрок", 0);
		Результат.Вставить("Ошибки", Новый Массив);
		Результат.Ошибки.Добавить(ОписаниеОшибки());
		Результат.Вставить("Предупреждения", Новый Массив);
		КодСостояния = 500;
	КонецПопытки;

	ЗаписьОтвет = Новый ЗаписьJSON;
	ЗаписьОтвет.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьОтвет, Результат);
	ТелоОтвета = ЗаписьОтвет.Закрыть();

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета, КодировкаТекста.UTF8);
	Возврат Ответ;

КонецФункции

Функция СтрокаСвойства(Данные, Имя)

	Значение = Данные.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции
